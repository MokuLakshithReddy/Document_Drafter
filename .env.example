# AI Document Reuse Platform - Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development  # Use 'production' in deployed environments (enforces strong SECRET_KEY and auth verification)
LOG_LEVEL=INFO

# Storage Settings
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25
MAX_PAGE_LIMIT=100
FILE_RETENTION_DAYS=30

# AI Provider Settings
# Options: 'deterministic' (offline, no key needed), 'gemini', 'openai', 'ollama'
AI_PROVIDER=deterministic

# Cloud AI API Keys (Optional - only needed if AI_PROVIDER is set to cloud provider)
GEMINI_API_KEY=your_gemini_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Security Configuration
# In production, SECRET_KEY must be a cryptographically secure random string of at least 32 characters.
SECRET_KEY=change_this_to_a_random_32_character_secret_in_production

# API Authentication & Session Isolation
# Set REQUIRE_AUTH=true to enforce API Key verification on all endpoints.
REQUIRE_AUTH=false
API_KEY=your_secure_api_key_here_at_least_16_chars

# CORS Origin Allowlist (comma-separated, no wildcards allowed)
# Note: Wildcard regex is strictly disabled for security. Specify exact schemes and hosts.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://ai-document-reuse.mokulakshithreddy.workers.dev
