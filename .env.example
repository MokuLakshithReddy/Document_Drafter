# AI Document Reuse Platform - Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage Settings
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25
MAX_PAGE_LIMIT=100
FILE_RETENTION_DAYS=30

# AI Provider Settings
# Options: 'deterministic' (offline, no key needed), 'gemini', 'openai', 'ollama'
AI_PROVIDER=deterministic

# Cloud AI API Keys (Optional - only needed if AI_PROVIDER is set to cloud provider)
GEMINI_API_KEY=your_gemini_api_key_placeholder
OPENAI_API_KEY=your_openai_api_key_placeholder
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Security
SECRET_KEY=change_this_to_a_random_secret_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
